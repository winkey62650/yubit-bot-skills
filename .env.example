AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=
APP_BASE_URL=https://academy.example.com
WORKER_BASE_URL=http://127.0.0.1:4174
WORKER_DISTRIBUTION_INTERVAL_MS=15000
WORKER_TRADING_INTERVAL_MS=300000
WORKER_AGENT_INTERVAL_MS=14400000
WORKER_REQUEST_TIMEOUT_MS=90000
WORKER_MAX_DISTRIBUTION_CLAIMS=10
CRON_SECRET=
# Vercel Preview only. Preview deliberately ignores CRON_SECRET.
PREVIEW_CRON_SECRET=
DATABASE_URL=
# Vercel Preview only. Must point to a separate Neon branch/database.
# Preview deliberately ignores DATABASE_URL and POSTGRES_URL.
PREVIEW_DATABASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Trading center: generate three different high-entropy values. Never reuse Bot tokens.
TRADER_CREDENTIALS_ENCRYPTION_KEY=
SPEAKER_TELEGRAM_WEBHOOK_SECRET=
PNL_CARD_SIGNING_SECRET=
# Preview never reuses the production SpeakerBot. Enable only with a dedicated test Bot.
SPEAKER_PREVIEW_WEBHOOK_ENABLED=false
SPEAKER_PREVIEW_BOT_TOKEN=
SPEAKER_PREVIEW_TELEGRAM_WEBHOOK_SECRET=
YUBIT_API_BASE_URL=https://openapi.yubit.com
NEWS_RSS_URL=https://cointelegraph.com/rss
# Preview only: explicit temporary fallback until an isolated Preview database is connected.
# Production ignores this switch and always requires DATABASE_URL.
DISTRIBUTION_ALLOW_JSON_FALLBACK=false
TRADING_ALLOW_JSON_FALLBACK=false

# Local release tooling only. Keep save/send confirmations false for planning.
RELEASE_STAGE=preview
TEST_BASE_URL=
TEST_USERNAME=
TEST_PASSWORD=
PROVISION_APPLY=false
APPLY_PRODUCTION_CONFIGURATION=false
ALLOW_LIVE_TELEGRAM=false

TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
YUBITADMIN_BOT_TOKEN=
SPEAKER_BOT_TOKEN=
TRADER1_BOT_TOKEN=
FORWARD_BOT_TOKEN=
JACK_BOT_TOKEN=
TONY_BOT_TOKEN=

# Required for production outbound messages sent by the authorized Telegram user.
# Create API credentials at https://my.telegram.org/apps and keep them server-side only.
# Production always fails closed when the user publisher is unavailable: there is no Bot fallback.
TELEGRAM_USER_PUBLISHER_REQUIRED=false
TELEGRAM_USER_PUBLISHER_USERNAME=Serenity_Crypto
# Exact chat IDs allowed for user publishing. Keep initial acceptance limited to the private Demo Channel.
TELEGRAM_USER_PUBLISHER_TARGETS=-1003862539988
# 32-byte hex or base64 key used to encrypt the persisted Telegram user session.
TELEGRAM_USER_SESSION_ENCRYPTION_KEY=
DEMO_TELEGRAM_CHAT_ID=-1003710405969
# Keep production distribution locked to Demo by default. Add only explicitly
# approved destinations as exact chatId:threadId pairs, separated by commas.
TELEGRAM_DEMO_ONLY=true
TELEGRAM_DISTRIBUTION_APPROVED_TARGETS=
# Trading signals and PNL cards use a separate safety lock.
TRADING_DEMO_ONLY=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

SEND_TELEGRAM=false
TELEGRAM_THREAD_ID=
SYMBOL_LIMIT=20
BINANCE_INTERVAL=1h
FAST_SMA=20
SLOW_SMA=50
NEWS_MODE=crypto
NEWS_LIMIT=4
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=
DAILY_EVENTS_API_URL=
DAILY_EVENTS_API_TOKEN=
DISCLAIMER_IMAGE_URL=
