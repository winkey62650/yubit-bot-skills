AUTH_USERNAME=
AUTH_PASSWORD=
# Restricted console account: manual publishing + read-only publisher status only.
MANUAL_PUBLISHER_USERNAME=
MANUAL_PUBLISHER_PASSWORD=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=
APP_BASE_URL=https://academy.example.com
WORKER_BASE_URL=http://127.0.0.1:4174
WORKER_DISTRIBUTION_INTERVAL_MS=300000
WORKER_COMPOSER_INTERVAL_MS=15000
WORKER_TRADING_INTERVAL_MS=300000
WORKER_AGENT_INTERVAL_MS=3600000
DISCORD_GATEWAY_ENABLED=false
WORKER_REQUEST_TIMEOUT_MS=90000
WORKER_MAX_DISTRIBUTION_CLAIMS=10
CRON_SECRET=
# Vercel Preview only. Preview deliberately ignores CRON_SECRET.
PREVIEW_CRON_SECRET=
DATABASE_URL=
# Use pg for a local PostgreSQL primary; omit for automatic driver selection.
DATABASE_DRIVER=
# Production keeps the prior Neon URL here as a read-only recovery source.
NEON_ARCHIVE_DATABASE_URL=
DATABASE_POOL_MAX=10
# Sole editorial knowledge base. Production deploys must keep this absolute and
# confined below /var/lib/yubit-academy so it survives immutable release changes.
OBSIDIAN_VAULT_PATH=/var/lib/yubit-academy/obsidian-vault
# Server-side daily deployment snapshots; archives never follow Vault symlinks.
OBSIDIAN_BACKUP_ROOT=/var/backups/yubit-academy/obsidian-vault
# Vercel Preview only. Must point to a separate Neon branch/database.
# Preview deliberately ignores DATABASE_URL and POSTGRES_URL.
PREVIEW_DATABASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Trading center: generate three different high-entropy values. Never reuse Bot tokens.
TRADER_CREDENTIALS_ENCRYPTION_KEY=
SPEAKER_TELEGRAM_WEBHOOK_SECRET=
PNL_CARD_SIGNING_SECRET=
# Preview never reuses the production SpeakerBot. Enable only with a dedicated test Bot.
SPEAKER_PREVIEW_WEBHOOK_ENABLED=false
SPEAKER_PREVIEW_BOT_TOKEN=
SPEAKER_PREVIEW_TELEGRAM_WEBHOOK_SECRET=
YUBIT_API_BASE_URL=https://openapi.yubit.com
NEWS_RSS_URL=https://cointelegraph.com/rss
# Preview only: explicit temporary fallback until an isolated Preview database is connected.
# Production ignores this switch and always requires DATABASE_URL.
DISTRIBUTION_ALLOW_JSON_FALLBACK=false
TRADING_ALLOW_JSON_FALLBACK=false

# Local release tooling only. Keep save/send confirmations false for planning.
RELEASE_STAGE=preview
TEST_BASE_URL=
TEST_USERNAME=
TEST_PASSWORD=
PROVISION_APPLY=false
APPLY_PRODUCTION_CONFIGURATION=false
ALLOW_LIVE_TELEGRAM=false
# Deployment-process switch (not an application feature flag). Keep at 1 for
# installation/acceptance so Worker and Discord keep their current runtime.
DEPLOY_NO_SEND=1

TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
YUBITADMIN_BOT_TOKEN=
SPEAKER_BOT_TOKEN=
TRADER1_BOT_TOKEN=
FORWARD_BOT_TOKEN=
JACK_BOT_TOKEN=
TONY_BOT_TOKEN=

# Production Forum-group publishing must use an authorized anonymous admin user
# and explicit send_as=group. It fails closed instead of exposing a Bot/user identity.
TELEGRAM_PUBLISHER_MODE=user
TELEGRAM_USER_PUBLISHER_REQUIRED=true
TELEGRAM_USER_PUBLISHER_USERNAME=Serenity_Crypto
# Exact Forum-group chat IDs allowed for the publisher. Keep acceptance Demo-only.
TELEGRAM_USER_PUBLISHER_TARGETS=-1003710405969
# User mode only: 32-byte hex or base64 key for the persisted Telegram session.
TELEGRAM_USER_SESSION_ENCRYPTION_KEY=
DEMO_TELEGRAM_CHAT_ID=-1003710405969
# Keep production distribution locked to Demo by default. Add only explicitly
# approved destinations as exact chatId:threadId pairs, separated by commas.
TELEGRAM_DEMO_ONLY=true
TELEGRAM_DISTRIBUTION_APPROVED_TARGETS=-1003710405969:8,-1003710405969:10,-1003710405969:16
# Trading signals and PNL cards use a separate safety lock.
TRADING_DEMO_ONLY=true
# User mode only.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

SEND_TELEGRAM=false
TELEGRAM_THREAD_ID=
SYMBOL_LIMIT=20
BINANCE_INTERVAL=1h
FAST_SMA=20
SLOW_SMA=50
NEWS_MODE=crypto
NEWS_LIMIT=4
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=
DAILY_EVENTS_API_URL=
DAILY_EVENTS_API_TOKEN=
DISCLAIMER_IMAGE_URL=

# HMAC key used only to attest read-only CTA preview boundaries.
# Use exactly 64 lowercase hexadecimal characters (32 random bytes), generated with
# `openssl rand -hex 32`, and keep it in the preview route and audit job.
CTA_PREVIEW_EVIDENCE_SECRET=
