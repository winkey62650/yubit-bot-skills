# Trading center: generate three different high-entropy values. Never reuse Bot tokens.
TRADER_CREDENTIALS_ENCRYPTION_KEY=
SPEAKER_TELEGRAM_WEBHOOK_SECRET=
PNL_CARD_SIGNING_SECRET=
# Preview never reuses the production SpeakerBot. Enable only with a dedicated test Bot.
