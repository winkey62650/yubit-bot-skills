[Unit]
Description=YUBIT Academy scheduled publishing and reconciliation worker
After=network-online.target yubit-academy-web.service
Wants=network-online.target
Requires=yubit-academy-web.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/yubit-academy/current
EnvironmentFile=/etc/yubit-academy/production.env
EnvironmentFile=-/etc/yubit-academy/release.env
Environment=NODE_ENV=production
Environment=PORT=4174
Environment=WORKER_BASE_URL=http://127.0.0.1:4174
Environment=PATH=/opt/yubit-node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/yubit-node/bin/node /opt/yubit-academy/current/scripts/production-worker.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
